PORT=5000

# Production Database Connection (Render / Cloud PostgreSQL)
# Render automatically provides DATABASE_URL when attaching a PostgreSQL database instance
DATABASE_URL=postgresql://user:password@hostname:5432/store_rating?sslmode=require

# Alternative Discrete Database Connection (Local Development / Custom Host)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=store_rating
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# Authentication Secrets
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d
